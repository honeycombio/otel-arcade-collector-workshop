# OTel Arcade — environment variable template.
# Copy to .env and edit. Compose reads .env automatically.

# Honeycomb API key. Optional for local development; if unset, the
# Collector's otlp/backend exporter will log export failures but the rest
# of the pipeline (debug + Visualizer) keeps working.
HONEYCOMB_API_KEY=

# Honeycomb OTLP endpoint. Default is the public Honeycomb ingest.
OTEL_EXPORTER_ENDPOINT=api.honeycomb.io:443

# Pinned Collector image. Bump deliberately — config syntax can change between releases.
COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.151.0

# Loadgen request rate (requests per second). Loadgen runs only with `--profile load`.
LOADGEN_RPS=5
